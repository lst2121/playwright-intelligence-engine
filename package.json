{
  "name": "playwright-intelligence-engine",
  "version": "0.1.0",
  "description": "Enterprise-grade Playwright reliability, failure diagnosis, and intent-preserving test verification engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "test-intelligence",
    "self-healing",
    "flaky-tests",
    "ast-manipulation",
    "trace-analysis"
  ],
  "author": "Playwright Intelligence Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
