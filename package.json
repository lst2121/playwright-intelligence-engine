{
  "name": "playwright-intelligence-engine",
  "version": "2.0.0",
  "description": "Enterprise-grade Playwright reliability, failure diagnosis, and intent-preserving test verification engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pw-intel": "bin/pw-intel.js",
    "playwright-intelligence-engine": "bin/pw-intel.js"
  },
  "files": [
    "dist",
    "bin",
    "src",
    "benchmarks",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.benchmarks.json --noEmit",
    "benchmark": "tsx benchmarks/runner/master-benchmark-runner.ts",
    "verify:all": "node scripts/verify/index.mjs",
    "verify:full": "node scripts/verify/index.mjs --full",
    "verify:baseline": "node scripts/verify-baseline.mjs"
  },
  "keywords": [
    "playwright",
    "test-intelligence",
    "self-healing",
    "flaky-tests",
    "ast-manipulation",
    "trace-analysis"
  ],
  "author": "Playwright Intelligence Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.30.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
